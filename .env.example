# CV Builder Environment Configuration

# Flask Configuration
FLASK_ENV=development
FLASK_DEBUG=True
SECRET_KEY=your-secret-key-here

# Application Settings
APP_NAME=CV Builder
APP_VERSION=1.0.0

# Template Settings
DEFAULT_TEMPLATE=classic
TEMPLATES_DIR=app/cv-templates

# File Upload Settings (if needed in the future)
MAX_CONTENT_LENGTH=16777216  # 16MB
UPLOAD_FOLDER=uploads

# PDF Generation Settings
PDF_QUALITY=high
PDF_DPI=300
